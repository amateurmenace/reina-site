---
layout: layouts/base.njk
title: "Donate"
description: "Give once or monthly to fund creative skills labs, mentorship, and youth-led community projects in Zimbabwe. Secure payments through PCI-compliant partners."
scripts: ["/assets/js/donate.js"]
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Donate</p>
    <h1 class="h-display">Fund a young creative's next move.</h1>
    <p class="lead">Your gift pays for studio time, materials, mentors, and showcases. Give once or monthly. Every amount is accounted for in our annual report.</p>
  </div>
</section>
<section class="section-tight"><div class="container donate-layout">
  <div>
    <div class="donate-card reveal" data-donate data-config='{{ site.donate | jsonify }}'>
      <div class="seg" role="group" aria-label="Gift frequency">
        <button type="button" data-freq="once" aria-pressed="true">One-time</button>
        <button type="button" data-freq="monthly" aria-pressed="false">Monthly</button>
      </div>
      <div class="amounts" data-amounts role="group" aria-label="Amount"></div>
      <div class="custom-amount"><span>{{ "$" if site.donate.currency == "USD" else site.donate.currency }}</span><input type="number" min="1" step="1" placeholder="Other amount" aria-label="Custom amount" data-custom /></div>
      <div class="impact-line" data-impact aria-live="polite"></div>
      <p class="small muted" style="text-align:center;margin:0">You are giving: <strong data-summary></strong></p>
      <div class="gateways" data-gateways></div>
      <p class="gateway-note"><svg width="16" height="16"><use href="#i-lock"/></svg>Payments are processed by PCI-DSS compliant providers. REINA never sees or stores your card details.</p>
      {% set d = site.donate %}
      {% if d.bank_name or d.mobile_money_number %}
      <div class="offline">
        <h2 class="h6">Bank transfer or mobile money</h2>
        <dl>
          {% if d.mobile_money_number %}<dt>{{ d.mobile_money_name or "Mobile money" }}</dt><dd>{{ d.mobile_money_number }} <button class="chip" type="button" data-copy="{{ d.mobile_money_number }}" style="padding:.2rem .6rem;font-size:.75rem">Copy</button></dd>{% endif %}
          {% if d.bank_name %}<dt>Bank</dt><dd>{{ d.bank_name }}{% if d.bank_branch %}, {{ d.bank_branch }}{% endif %}</dd>{% endif %}
          {% if d.bank_account_name %}<dt>Account name</dt><dd>{{ d.bank_account_name }}</dd>{% endif %}
          {% if d.bank_account_number %}<dt>Account number</dt><dd>{{ d.bank_account_number }} <button class="chip" type="button" data-copy="{{ d.bank_account_number }}" style="padding:.2rem .6rem;font-size:.75rem">Copy</button></dd>{% endif %}
          {% if d.bank_swift %}<dt>SWIFT</dt><dd>{{ d.bank_swift }}</dd>{% endif %}
        </dl>
        <p class="small muted" style="margin:.75rem 0 0">Email <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a> after transferring so we can send a receipt.</p>
      </div>
      {% endif %}
    </div>
  </div>
  <div>
    <div class="reveal">
      <p class="eyebrow">Where the money goes</p>
      <h2>Programs first. Always.</h2>
      {% set stops = [] %}{% set acc = 0 %}
      {% for a in site.donate.allocation %}{% set stops = (stops.push(a.color ~ " " ~ acc ~ "% " ~ (acc + a.pct) ~ "%"), stops) %}{% set acc = acc + a.pct %}{% endfor %}
      <div class="grid grid-2" style="align-items:center">
        <div class="donut" style="--stops: {{ stops | join(', ') }}" role="img" aria-label="Allocation of funds: {% for a in site.donate.allocation %}{{ a.label }} {{ a.pct }}%{% if not loop.last %}, {% endif %}{% endfor %}"><div class="donut-center"><strong>{{ site.donate.allocation[0].pct }}%</strong><span>to programs</span></div></div>
        <ul class="legend">{% for a in site.donate.allocation %}<li><i style="--c: {{ a.color }}"></i>{{ a.label }}<strong>{{ a.pct }}%</strong></li>{% endfor %}</ul>
      </div>
      <p class="small muted">Allocation reflects the current budget and is reconciled in each <a href="/transparency/">annual report</a>.</p>
    </div>
    <div class="reveal" style="margin-top:2.5rem">
      <h3>What your gift does</h3>
      <ul class="step-items">{% for l in site.donate.impact_lines %}<li><svg width="18" height="18"><use href="#i-check"/></svg><span><strong>{{ "$" if site.donate.currency == "USD" else site.donate.currency }}{{ l.amount }}</strong> {{ l.text }}</span></li>{% endfor %}</ul>
    </div>
    <div class="reveal" style="margin-top:2.5rem">
      <h3>Trust and security</h3>
      <div class="chip-row">
        <span class="chip"><svg width="16" height="16"><use href="#i-lock"/></svg>HTTPS everywhere</span>
        <span class="chip"><svg width="16" height="16"><use href="#i-shield"/></svg>PCI-compliant gateways</span>
        <span class="chip"><svg width="16" height="16"><use href="#i-verified"/></svg>Receipts for every gift</span>
        <span class="chip"><svg width="16" height="16"><use href="#i-download"/></svg>Audited annual reports</span>
      </div>
      <p class="small muted" style="margin-top:1rem">Questions about giving, grants, or in-kind support? Email our institutional giving contact at <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>. See the <a href="/refunds/">refund policy</a>.</p>
    </div>
  </div>
</div></section>
