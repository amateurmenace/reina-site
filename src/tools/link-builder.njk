---
layout: layouts/base.njk
title: "Campaign link builder"
description: "Build tagged links for social posts and partner campaigns so REINA can see exactly which channels drive traffic."
noindex: true
nosearch: true
scripts: ["/assets/js/link-builder.js"]
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Team tool</p>
    <h1 class="h-display">Campaign link builder.</h1>
    <p class="lead">Paste a page, pick a channel, and copy a tagged link. Analytics will show the visit under that source and campaign, so you can measure which posts and platforms actually send people here.</p>
  </div>
</section>
<section class="section-tight"><div class="container tool-grid" data-link-builder>
  <form class="form">
    <div class="field"><label for="lb-page">Page to link to</label><input id="lb-page" type="text" name="page" value="/" placeholder="/programs/ or a full URL" /><span class="hint">A path on this site, or any full URL.</span></div>
    <div class="field"><span class="small muted">Quick channel presets</span><div class="chip-row">
      <button class="chip" type="button" data-lb-preset="instagram:social">Instagram</button><button class="chip" type="button" data-lb-preset="facebook:social">Facebook</button><button class="chip" type="button" data-lb-preset="x:social">X</button><button class="chip" type="button" data-lb-preset="whatsapp:social">WhatsApp</button><button class="chip" type="button" data-lb-preset="linkedin:social">LinkedIn</button><button class="chip" type="button" data-lb-preset="newsletter:email">Newsletter</button><button class="chip" type="button" data-lb-preset="partner:referral">Partner site</button><button class="chip" type="button" data-lb-preset="poster:qr">Printed poster</button>
    </div></div>
    <div class="form-row">
      <div class="field"><label for="lb-source">Source</label><input id="lb-source" type="text" name="source" value="instagram" placeholder="instagram, partner-name" /></div>
      <div class="field"><label for="lb-medium">Medium</label><input id="lb-medium" type="text" name="medium" value="social" placeholder="social, email, referral, qr" /></div>
    </div>
    <div class="form-row">
      <div class="field"><label for="lb-campaign">Campaign</label><input id="lb-campaign" type="text" name="campaign" value="open-call-2026" placeholder="open-call-2026" /></div>
      <div class="field"><label for="lb-content">Content <span class="muted">(optional)</span></label><input id="lb-content" type="text" name="content" placeholder="story-1, bio-link" /></div>
    </div>
  </form>
  <div>
    <p class="h6">Your tagged link</p>
    <div class="output-box" data-lb-out></div>
    <div class="btn-row"><button class="btn btn-primary" type="button" data-lb-copy><svg><use href="#i-copy"/></svg>Copy link</button></div>
    <p class="h6" style="margin-top:2rem">QR code for print</p>
    <div class="qr" data-lb-qr></div>
    <p class="small muted" style="margin-top:1rem">QR images are generated by a third-party service when the page is open; nothing is stored.</p>
  </div>
</div></section>
<section class="section section-tint"><div class="container">
  <div class="section-head reveal"><div><p class="eyebrow">Short links</p><h2>Ready-made links for bios.</h2></div><p>Managed in the CMS under “Short links”. Each one redirects with campaign tags already attached.</p></div>
  <table class="go-table"><thead><tr><th>Short link</th><th>Destination</th><th>Tags</th></tr></thead><tbody>
    {% for l in collections.links %}<tr><td><code>{{ l.url | absolute }}</code> <button class="chip" type="button" data-copy="{{ l.url | absolute }}" style="padding:.2rem .6rem;font-size:.75rem">Copy</button></td><td>{{ l.data.label }}<br><span class="small muted">{{ l.data.destination }}</span></td><td class="small muted">{{ l.data.source }} / {{ l.data.medium }} / {{ l.data.campaign or l.fileSlug }}</td></tr>{% endfor %}
  </tbody></table>
</div></section>
