---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.full_name }}",
  "short_name": "{{ site.name }}",
  "description": "{{ site.description }}",
  "start_url": "{{ pathPrefix }}",
  "display": "standalone",
  "background_color": "#fffdf8",
  "theme_color": "#14121f",
  "icons": [
    { "src": "{{ pathPrefix }}assets/brand/mark-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ pathPrefix }}assets/brand/mark-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
