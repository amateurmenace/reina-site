{%- set pageTitle = (title ~ " · " ~ site.name) if title else (site.name ~ " · " ~ site.tagline) -%}
{%- set metaTitle = meta_title or pageTitle -%}
{%- set metaDesc = description or summary or site.description -%}
{%- set ogImage = (image or "/assets/brand/og-default.png") | absolute -%}
{%- set canonical = page.url | absolute -%}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc | plain }}" />
<link rel="canonical" href="{{ canonical }}" />
{% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
<meta name="theme-color" content="#14121f" />
<meta name="color-scheme" content="light" />
<meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{{ metaTitle }}" />
<meta property="og:description" content="{{ metaDesc | plain }}" />
<meta property="og:url" content="{{ canonical }}" />
<meta property="og:image" content="{{ ogImage }}" />
<meta property="og:image:alt" content="{{ image_alt or (site.name ~ ' — ' ~ site.tagline) }}" />
<meta property="og:locale" content="{{ site.locale }}" />
{% if layout == 'layouts/post.njk' %}<meta property="article:published_time" content="{{ page.date | isoDate }}" />{% for t in topics %}<meta property="article:tag" content="{{ t }}" />{% endfor %}{% endif %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ metaTitle }}" />
<meta name="twitter:description" content="{{ metaDesc | plain }}" />
<meta name="twitter:image" content="{{ ogImage }}" />
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/assets/brand/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/atom+xml" title="{{ site.name }} news" href="/feed.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/assets/css/main.css" />
<script>
  window.REINA = {
    prefix: "{{ pathPrefix }}",
    siteUrl: "{{ siteUrl }}",
    name: "{{ site.name }}",
    analytics: {{ site.analytics | jsonify | safe }},
    counters: {{ site.counters | jsonify | safe }},
    forms: {{ site.forms | jsonify | safe }}
  };
</script>
{% if site.analytics.ga4_id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.analytics.ga4_id }}',{anonymize_ip:true});</script>
{% endif %}
{% if site.analytics.plausible_domain %}
<script defer data-domain="{{ site.analytics.plausible_domain }}" src="https://plausible.io/js/script.outbound-links.file-downloads.tagged-events.js"></script>
<script>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}</script>
{% endif %}
{% if site.analytics.goatcounter_code %}
<script data-goatcounter="https://{{ site.analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
{% if structured_data %}<script type="application/ld+json">{{ structured_data | safe }}</script>{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NGO",
  "name": "{{ site.full_name }}",
  "alternateName": "{{ site.name }}",
  "url": "{{ '/' | absolute }}",
  "logo": "{{ '/assets/brand/mark-512.png' | absolute }}",
  "slogan": "{{ site.tagline }}",
  "description": "{{ site.description }}",
  "email": "{{ site.contact.email }}",
  "telephone": "{{ site.contact.phone }}",
  "address": { "@type": "PostalAddress", "addressLocality": "{{ site.city }}", "addressCountry": "ZW" },
  "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
