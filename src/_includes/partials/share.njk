{%- set shareUrl = page.url | absolute -%}
<div class="share" data-share data-url="{{ shareUrl }}" data-title="{{ title }}" data-text="{{ summary or description or '' }}">
  <span class="share-label"><svg width="18" height="18"><use href="#i-share"/></svg>Share this</span>
  <div class="share-buttons">
    <a class="share-btn" data-share-net="whatsapp" href="https://wa.me/?text=" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg width="18" height="18"><use href="#i-whatsapp"/></svg><span>WhatsApp</span></a>
    <a class="share-btn" data-share-net="x" href="https://twitter.com/intent/tweet" target="_blank" rel="noopener" aria-label="Share on X"><svg width="18" height="18"><use href="#i-x"/></svg><span>X</span></a>
    <a class="share-btn" data-share-net="facebook" href="https://www.facebook.com/sharer/sharer.php" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg width="18" height="18"><use href="#i-facebook"/></svg><span>Facebook</span></a>
    <a class="share-btn" data-share-net="linkedin" href="https://www.linkedin.com/sharing/share-offsite/" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg width="18" height="18"><use href="#i-linkedin"/></svg><span>LinkedIn</span></a>
    <a class="share-btn" data-share-net="email" href="mailto:?" aria-label="Share by email"><svg width="18" height="18"><use href="#i-mail"/></svg><span>Email</span></a>
    <button class="share-btn" type="button" data-share-net="copy" aria-label="Copy link"><svg width="18" height="18"><use href="#i-copy"/></svg><span>Copy link</span></button>
    <button class="share-btn share-native" type="button" data-share-net="native" hidden><svg width="18" height="18"><use href="#i-share"/></svg><span>More</span></button>
  </div>
</div>
