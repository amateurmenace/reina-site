<a class="card news-card reveal" href="{{ p.url }}">
  <div class="card-media"><img src="{{ p.data.image or ('/assets/img/art/post-' ~ ((p.data.title | hue) % 6 + 1) ~ '.svg') }}" alt="{{ p.data.image_alt or '' }}" loading="lazy" width="640" height="400" /></div>
  <div class="card-body">
    <p class="card-kicker">{{ p.data.kind or 'News' }} · <time datetime="{{ p.date | isoDate }}">{{ p.data.date_display or (p.date | readableDate("d LLL yyyy")) }}</time></p>
    <h3 class="card-title">{{ p.data.title }}</h3>
    <p class="card-text">{{ p.data.summary }}</p>
    <span class="link-arrow">Read<svg width="18" height="18"><use href="#i-arrow"/></svg></span>
  </div>
</a>
