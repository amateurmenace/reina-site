<a class="card program-card reveal" href="{{ p.url }}" data-status="{{ p.data.status }}" data-theme="{{ p.data.theme | slug2 }}">
  <div class="card-media"><img src="{{ p.data.image or ('/assets/img/art/program-' ~ ((p.data.title | hue) % 6 + 1) ~ '.svg') }}" alt="{{ p.data.image_alt or '' }}" loading="lazy" width="640" height="400" />
    <span class="status-pill status-{{ p.data.status }}">{{ 'Current' if p.data.status == 'current' else ('Upcoming' if p.data.status == 'upcoming' else 'Completed') }}</span>
  </div>
  <div class="card-body">
    <p class="card-kicker">{{ p.data.theme }}{% if p.data.timeline %} · {{ p.data.timeline }}{% endif %}</p>
    <h3 class="card-title">{{ p.data.title }}</h3>
    <p class="card-text">{{ p.data.summary }}</p>
    <span class="link-arrow">Explore<svg width="18" height="18"><use href="#i-arrow"/></svg></span>
  </div>
</a>
