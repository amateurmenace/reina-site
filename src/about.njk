---
layout: layouts/base.njk
title: "About REINA"
description: "Resources of Empowerment through Innovation and New Artistry (REINA) is a youth-led organization in Zimbabwe. Our mission, vision, values, aims, objectives, and theory of change."
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">About us</p>
    <h1 class="h-display">Youth-led. Creativity-first. Built in Zimbabwe.</h1>
    <p class="lead">{{ about.about }}</p>
  </div>
</section>

<section class="section-tight">
  <div class="container grid grid-2 reveal-stagger">
    <div class="feature-card" style="--accent: var(--flame-soft)">
      <span class="icon-blob"><svg><use href="#i-compass"/></svg></span>
      <p class="eyebrow">Mission</p>
      <h2 style="font-size:1.6rem">{{ about.mission }}</h2>
    </div>
    <div class="feature-card" style="--accent: var(--jac-soft)">
      <span class="icon-blob"><svg><use href="#i-globe"/></svg></span>
      <p class="eyebrow">Vision</p>
      <h2 style="font-size:1.6rem">{{ about.vision }}</h2>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="reveal">
      <p class="eyebrow">Our story</p>
      <h2>Talent everywhere. Resources almost nowhere. So we built the resource.</h2>
      {% for p in about.story %}<p class="{{ 'lead' if loop.first }}">{{ p }}</p>{% endfor %}
      <p class="footer-motto" style="color:var(--flame-2);font-size:1.4rem;margin:1.5rem 0 0">“{{ about.motto }}”</p>
    </div>
    <div class="split-media reveal"><img src="/assets/img/art/about-story.svg" alt="Abstract composition of overlapping shapes in orange, gold, purple, and teal" width="800" height="600" /></div>
  </div>
</section>

<section class="section section-tint" id="values">
  <div class="container">
    <div class="section-head reveal"><div><p class="eyebrow">Core values</p><h2>What guides every decision.</h2></div><p>Tap a value to read what it means in practice.</p></div>
    <div class="values reveal-stagger">
      {% set vcols = ["var(--flame-soft)","var(--jac-soft)","var(--sun-soft)","var(--river-soft)","var(--flame-soft)"] %}
      {% for v in about.values %}
      <button class="value" type="button" data-value aria-expanded="false" style="--accent: {{ vcols[loop.index0] }}; --accent-soft: {{ vcols[loop.index0] }}">
        <span class="icon-blob"><svg><use href="#i-{{ v.icon }}"/></svg></span><span class="value-n">0{{ loop.index }}</span>
        <h3>{{ v.name }}</h3><p>{{ v.short }}</p><span class="value-detail">{{ v.text }}</span>
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="aims">
  <div class="container">
    <div class="split" style="align-items:start">
      <div class="reveal">
        <p class="eyebrow">Our aim</p>
        {% for a in about.aims %}<h2 style="font-size:clamp(1.4rem,1rem+1.6vw,2.1rem)">{{ a }}</h2>{% endfor %}
      </div>
      <div class="reveal-stagger">
        <p class="eyebrow">Objectives</p>
        {% for o in about.objectives %}
        <div class="story-card" style="margin-bottom:.75rem;border-left:4px solid var(--flame)"><p class="card-kicker">Objective {{ loop.index }}</p><h3>{{ o.title }}</h3><p>{{ o.text }}</p></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" id="theory-of-change">
  <div class="container">
    <div class="section-head reveal"><div><p class="eyebrow">Theory of change</p><h2>From inputs to impact.</h2></div><p>The chain we hold ourselves to, and report against.</p></div>
    {% include "partials/stepper.njk" %}
  </div>
</section>

<section class="section" id="leadership">
  <div class="container">
    <div class="section-head reveal"><div><p class="eyebrow">Governance and leadership</p><h2>Who is accountable.</h2></div><a class="link-arrow" href="/team/">Full team and board<svg width="18" height="18"><use href="#i-arrow"/></svg></a></div>
    <div class="grid grid-4 reveal-stagger">
      {% for m in collections.team | limit(4) %}{% include "partials/person-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

<section class="section section-tint" id="compliance">
  <div class="container">
    <div class="section-head reveal"><div><p class="eyebrow">Compliance and legal status</p><h2>On the record.</h2></div><a class="link-arrow" href="/transparency/">Reports and policies<svg width="18" height="18"><use href="#i-arrow"/></svg></a></div>
    {% include "partials/registration.njk" %}
  </div>
</section>

<section class="section">
  <div class="container"><div class="cta-band reveal"><div><h2>Want to build this with us?</h2><p>Volunteer, mentor, partner, or fund a program.</p></div><div class="btn-row"><a class="btn btn-primary btn-lg" href="/get-involved/">Get involved</a><a class="btn btn-ghost-light btn-lg" href="/contact/">Contact us</a></div></div></div>
</section>
